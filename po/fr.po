#: crates/pdrive-app/src/window.rs:30
msgid "Starting…"
msgstr "Démarrage…"

#: crates/pdrive-app/src/window.rs:31
msgid "Service not running"
msgstr "Service arrêté"

#: crates/pdrive-app/src/window.rs:32
msgid "Not mounted"
msgstr "Non monté"

#: crates/pdrive-app/src/window.rs:33
msgid "Syncing…"
msgstr "Synchronisation…"

#: crates/pdrive-app/src/window.rs:34 crates/pdrived/src/dbus.rs:273
msgid "Up to date"
msgstr "À jour"

#: crates/pdrive-app/src/window.rs:35
msgid "Error: an upload failed"
msgstr "Erreur : un envoi a échoué"

#: crates/pdrive-app/src/window.rs:66
msgid ""
"No notification area found. On GNOME, enable the “AppIndicator and "
"KStatusNotifierItem Support” extension to get the PDrive icon."
msgstr ""
"Aucune zone de notification détectée. Sous GNOME, activez l’extension "
"« AppIndicator and KStatusNotifierItem Support » pour afficher l’icône de "
"PDrive."


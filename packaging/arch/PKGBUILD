# Maintainer: Bertrand PRESLES <bpresles@gmail.com>
# PDrive for Linux: unofficial Proton Drive client (not affiliated with Proton AG).
#
# Build without network: the first source holds the project and its vendored Rust crates
# (scripts/make-source-tarball.sh), the second the prebuilt native libraries
# (scripts/package-native.sh). Both are local files (scripts/container/build-arch.sh copies them
# next to this file); the native libraries are verified against the sums shipped in their archive.

# Revisions of the pinned Proton sources the native archive was built from.
# Kept in sync with scripts/build-native.sh by scripts/check-version.sh.
_native_id=b68d64b-fc2c108
# Platform of the native archive.
case "$CARCH" in aarch64) _rid=linux-arm64 ;; *) _rid=linux-x64 ;; esac

# Names tied to the D-Bus / application identifiers (PLAN.md renames them together).
_app_id=io.github.bpresles.PDrive.App
_cloud_ini=io.github.bpresles.PDrive.ini

pkgname=pdrive-for-linux
pkgver=0.2.2
pkgrel=1
pkgdesc='Unofficial Proton Drive client for Linux (FUSE mount, Nautilus integration)'
arch=(x86_64 aarch64)
url='https://github.com/bpresles/PDrive-for-Linux'
# GPL-3.0-or-later: this project. Bundled components: see THIRD_PARTY_NOTICES and licenses/*.tsv.
license=(GPL-3.0-or-later)
# fuser is built without libfuse: the daemon calls fusermount3.
# Tokens are stored through the Secret Service API. No provider is listed on purpose: the
# desktop brings its own (oo7, gnome-keyring, kwallet, keepassxc...), and pulling in a second
# one makes two Secret Services compete for the session.
depends=(fuse3 gtk4 libadwaita glib2 hicolor-icon-theme)
makedepends=(cargo gcc make gettext desktop-file-utils pkgconf nautilus xz)
optdepends=('nautilus: file manager integration (emblems, menu entries)'
            'gnome-shell-extension-appindicator: tray icon on GNOME')
options=(!lto !debug)
source=("pdrive-for-linux-$pkgver.tar.xz"
        "pdrive-native-$_rid-$_native_id.tar.xz")
sha256sums=('SKIP' 'SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    ( cd "$srcdir/pdrive-native-$_rid-$_native_id" && sha256sum -c SHA256SUMS )
    mkdir -p native/$_rid
    install -m0755 "$srcdir/pdrive-native-$_rid-$_native_id"/*.so native/$_rid/
    # One version everywhere: the tarball must carry the version of the PKGBUILD.
    local cargo_version
    cargo_version=$(awk '/^\[workspace\.package\]/{f=1;next} /^\[/{f=0} f && /^version *=/{gsub(/"/,"",$3); print $3; exit}' Cargo.toml)
    test "$cargo_version" = "$pkgver" || { echo "Cargo.toml version $cargo_version != PKGBUILD $pkgver" >&2; return 1; }
}

build() {
    cd "$pkgname-$pkgver"
    export PDSDK_LIB_DIR="$PWD/native/$_rid"
    # Run-time location (rpath, and where the SDK loads libproton_crypto.so from).
    export PDSDK_RUNTIME_LIB_DIR=/usr/lib/pdrive
    cargo build --release --frozen --offline -p pdrived -p pdrive -p pdrive-app
    make -C extension LOCALEDIR=/usr/share/locale
}

check() {
    cd "$pkgname-$pkgver"
    desktop-file-validate "packaging/$_app_id.desktop"
    # The binaries must not refer to the build tree (the SDK loads libproton_crypto.so from that path).
    local b
    for b in pdrive pdrived; do
        ! grep -q "$PWD/native" "target/release/$b" || { echo "$b refers to the build tree" >&2; return 1; }
        grep -q /usr/lib/pdrive "target/release/$b"
    done
}

package() {
    cd "$pkgname-$pkgver"
    install -Dpm0755 target/release/pdrive target/release/pdrived target/release/pdrive-app -t "$pkgdir/usr/bin"
    install -Dpm0755 native/$_rid/libproton_drive_sdk.so native/$_rid/libproton_crypto.so -t "$pkgdir/usr/lib/pdrive"

    make -C extension install DESTDIR="$pkgdir" LOCALEDIR=/usr/share/locale

    install -Dpm0644 packaging/man/*.1 -t "$pkgdir/usr/share/man/man1"
    install -Dpm0644 "packaging/$_cloud_ini" -t "$pkgdir/usr/share/cloud-providers"
    desktop-file-install --dir="$pkgdir/usr/share/applications" "packaging/$_app_id.desktop"
    (cd packaging/icons/hicolor && find . -name '*.svg' -print0 | while IFS= read -r -d '' icon; do
        install -Dpm0644 "$icon" "$pkgdir/usr/share/icons/hicolor/$icon"
    done)

    local lang
    while read -r lang; do
        [[ -z "$lang" || "$lang" == \#* ]] && continue
        install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt --check -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/pdrive.mo" "po/$lang.po"
    done < po/LINGUAS

    install -d "$pkgdir/usr/share/licenses/$pkgname" "$pkgdir/usr/share/doc/$pkgname"
    install -Dpm0644 LICENSE THIRD_PARTY_NOTICES THIRD_PARTY_CRATES.txt \
        "$srcdir/pdrive-native-$_rid-$_native_id"/LICENSE-* -t "$pkgdir/usr/share/licenses/$pkgname"
    install -Dpm0644 "$srcdir/pdrive-native-$_rid-$_native_id/SOURCES.txt" licenses/*.tsv -t "$pkgdir/usr/share/doc/$pkgname"
}
